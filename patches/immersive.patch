+        fun addButton(label: String, mode: String? = null, action: () -> Unit) {
+            val button = TextView(this).apply {
+                text = label
+                textSize = 16f
+                setTextColor(Color.WHITE)
+                gravity = Gravity.CENTER
+                minWidth = Ui.dp(this@ReaderActivity, 34)
+                minHeight = Ui.dp(this@ReaderActivity, 34)
+                setPadding(Ui.dp(this@ReaderActivity, 5), Ui.dp(this@ReaderActivity, 3),
+                    Ui.dp(this@ReaderActivity, 5), Ui.dp(this@ReaderActivity, 3))
+                setOnClickListener { action() }
+                contentDescription = when (mode) {
+                    "pen" -> "Pen"
+                    "highlighter" -> "Highlight"
+                    "eraser" -> "Erase"
+                    "move" -> "Move and zoom"
+                    else -> label
+                }
+            }
+            compactToolbar.addView(button, LinearLayout.LayoutParams(-2, -2))
+            if (mode != null) compactModes[mode] = button
+        }
+        addButton("✎", "pen") { activate("pen") }
