+    /** Tiny floating ink controls: full PDF surface remains underneath. */
+    private fun buildCompactToolbar(frame: FrameLayout) {
+        compactToolbar = Ui.row(this).apply {
+            setPadding(Ui.dp(this@ReaderActivity, 3), Ui.dp(this@ReaderActivity, 3),
+                Ui.dp(this@ReaderActivity, 3), Ui.dp(this@ReaderActivity, 3))
